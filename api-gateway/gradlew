#!/bin/sh
# Gradle wrapper script
GRADLE_VERSION=8.14
GRADLE_HOME="$HOME/.gradle/wrapper/dists/gradle-$GRADLE_VERSION-bin"
GRADLE_BIN="$GRADLE_HOME/gradle-$GRADLE_VERSION/bin/gradle"

if [ ! -f "$GRADLE_BIN" ]; then
    echo "Downloading Gradle $GRADLE_VERSION..."
    mkdir -p "$GRADLE_HOME"
    TMPDIR=$(mktemp -d)
    curl -sL "https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip" -o "$TMPDIR/gradle.zip"
    unzip -q "$TMPDIR/gradle.zip" -d "$GRADLE_HOME"
    rm -rf "$TMPDIR"
fi

exec "$GRADLE_BIN" "$@"
